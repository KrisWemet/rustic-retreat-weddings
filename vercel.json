{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/enchanted-wedding",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/enchanted",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/enchated",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/rules",
      "destination": "/rustic-retreat-site-rules.html",
      "permanent": true
    },
    {
      "source": "/guidelines",
      "destination": "/rustic-retreat-site-rules.html",
      "permanent": true
    },
    {
      "source": "/cabin",
      "destination": "/venue",
      "permanent": true
    },
    {
      "source": "/decor",
      "destination": "/venue",
      "permanent": true
    },
    {
      "source": "/weddings",
      "destination": "/packages",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/about",
      "destination": "/about/index.html"
    },
    {
      "source": "/venue",
      "destination": "/venue/index.html"
    },
    {
      "source": "/packages",
      "destination": "/packages/index.html"
    },
    {
      "source": "/gallery",
      "destination": "/gallery/index.html"
    },
    {
      "source": "/faqs",
      "destination": "/faqs/index.html"
    },
    {
      "source": "/contact",
      "destination": "/contact/index.html"
    },
    {
      "source": "/camping-wedding",
      "destination": "/camping-wedding/index.html"
    },
    {
      "source": "/diy-wedding-venue-alberta",
      "destination": "/diy-wedding-venue-alberta/index.html"
    },
    {
      "source": "/elopements",
      "destination": "/elopements/index.html"
    },
    {
      "source": "/privacy",
      "destination": "/privacy/index.html"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/booking-202(6|7)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; img-src 'self' data: blob: https:; font-src 'self' https://fonts.gstatic.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://www.google-analytics.com https://connect.facebook.net https://www.googleadservices.com https://googleads.g.doubleclick.net; connect-src 'self' https://formspree.io https://formsubmit.co https://www.google-analytics.com https://analytics.google.com https://*.google-analytics.com https://www.googletagmanager.com https://*.sanity.io https://api.openai.com https://connect.facebook.net https://www.facebook.com https://www.googleadservices.com https://googleads.g.doubleclick.net https://www.google.com; form-action 'self' https://formspree.io https://formsubmit.co; frame-src 'self' https://www.facebook.com https://td.doubleclick.net https://bid.g.doubleclick.net; upgrade-insecure-requests"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), browsing-topics=(), interest-cohort=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        }
      ]
    }
  ]
}
